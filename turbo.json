{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "api#build": {
      "outputs": ["openapi/Api.json"]
    },
    "@st/api-client#build": {
      "dependsOn": ["api#build"],
      "outputs": ["src/schema.d.ts"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "test": {},
    "test:e2e": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
