# Copy to .env.local and fill in from the Clerk dashboard.
#
# Not needed while the temporary keyless application from `clerk init` is in
# use — it supplies credentials through .clerk/keyless.json instead. Claim the
# application with `npx clerk@latest auth login` to get real keys.
#
# The customer-facing Clerk instance. apps/admin authenticates against a
# different one; never reuse these there.

# Server-only. Never rename this with a NEXT_PUBLIC_ prefix.
CLERK_SECRET_KEY=sk_test_...

# Sent to the browser by design — identifies the instance, authorizes nothing.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Where this instance runs: local | staging | production. Leave unset locally.
# Only a deployment sets it — NODE_ENV cannot serve this purpose because
# `next build` sets NODE_ENV=production on a developer's machine as well.
# APP_ENV=production
