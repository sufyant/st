# Copy to .env.local and fill in.
#
# `clerk env pull` writes the two keys below straight into .env.local; the
# rest are ours and have to be set by hand.
#
# This is the *customer-facing* Clerk instance. apps/admin authenticates
# against a different one — never reuse these keys there.

# Server-only. Never rename this with a NEXT_PUBLIC_ prefix.
CLERK_SECRET_KEY=sk_test_...

# Sent to the browser by design — it identifies the instance, authorizes nothing.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Where Clerk sends an unauthenticated visitor, and where it returns them when
# nothing else asked for a destination. Both match Clerk's own defaults; they
# are set explicitly so the values live here rather than in the SDK.
#
# There is deliberately no NEXT_PUBLIC_CLERK_SIGN_UP_URL. Access is by
# invitation, the route does not exist, and the instance is set to
# sign_up_mode=restricted. Setting one would re-add "Sign up" links to Clerk's
# own components pointing at a 404.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/

# Where this instance runs: local | staging | production. Leave unset locally.
# Only a deployment sets it — NODE_ENV cannot serve this purpose because
# `next build` sets NODE_ENV=production on a developer's machine as well.
# APP_ENV=production
