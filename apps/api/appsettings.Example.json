{
  "Host": {
    "Role": "web",
    "ShutdownTimeout": "00:00:30",
    "Cors": {
      "AllowedOrigins": [
        "https://app.example.com"
      ]
    }
  },
  "ConnectionStrings": {
    "Database": "Host=database.example.com;Database=app;Username=api_application;Password=<application role password>",
    "Messaging": "Host=database-direct.example.com;Database=app;Username=api_application;Password=<application role password>;Keepalive=30;Tcp Keepalive=true",
    "Migrations": "Host=database-direct.example.com;Database=app;Username=api_owner;Password=<owner role password>"
  },
  "Authentication": {
    "Clerk": {
      "Issuer": "https://clerk.example.com",
      "AuthorizedParties": [
        "https://app.example.com"
      ]
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": [
      "10.0.0.1"
    ],
    "KnownNetworks": [
      "10.0.0.0/8"
    ]
  },
  "RateLimiting": {
    "PermitLimit": 1000,
    "Window": "00:01:00",
    "InvitationAccept": {
      "PermitLimit": 10,
      "Window": "00:01:00"
    }
  },
  "Pipeline": {
    "SlowCommandThreshold": "00:00:00.500"
  },
  "ControlPlane": {
    "FirstSystemAdminEmail": "admin@example.com",
    "ActivationTimeout": "00:10:00",
    "InvitationEmailTimeout": "02:00:00",
    "CancellationTimeout": "00:10:00",
    "Clerk": {
      "SecretKey": "<Clerk secret key>",
      "BackendApiUrl": "https://api.clerk.com/v1/",
      "Timeout": "00:00:10"
    },
    "Invitations": {
      "AcceptUrl": "https://app.example.com/invitations/accept",
      "Lifetime": "7.00:00:00"
    }
  },
  "Notifications": {
    "InvitationEmailRetryDelays": [
      "00:00:10",
      "00:01:00",
      "00:05:00",
      "00:15:00"
    ],
    "Resend": {
      "ApiKey": "<Resend API key>",
      "From": "App <no-reply@example.com>",
      "ApiUrl": "https://api.resend.com/",
      "Timeout": "00:00:10"
    }
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "https://otel-collector.example.com:4317",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Wolverine": "Warning",
        "JasperFx": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
