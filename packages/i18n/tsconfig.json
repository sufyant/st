{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    // For `console` only. Says nothing about the runtime — the same types
    // are what packages/tokens uses, and mobile consumes both.
    "types": ["node"]
  },
  "include": ["src", "messages"],
  "exclude": ["node_modules"]
}
